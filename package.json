{
  "name": "fitai",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/prepare-dev.mjs && next dev --webpack",
    "dev:clean": "node scripts/prepare-dev.mjs --clean && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "next typegen && tsc --noEmit --incremental false",
    "seed:exercises": "tsx --env-file=.env.local scripts/seed-free-exercise-db.ts --reset",
    "audit:plans": "tsx --env-file=.env.local scripts/audit-plan-generation.ts",
    "audit:history": "tsx --env-file=.env.local scripts/audit-plan-history-continuity.ts",
    "audit:trainers": "tsx scripts/audit-trainer-marketplace.ts",
    "translate:setup": "python scripts/setup-argos-translate.py",
    "translate:exercises:es": "tsx --env-file=.env.local scripts/translate-exercises-es.ts",
    "validate:exercise-pilot": "tsx scripts/validate-exercise-visual-pilot.ts",
    "validate:exercise-catalog-v1": "tsx scripts/validate-exercise-visual-catalog-v1.ts && python scripts/validate_exercise_visual_assets.py",
    "validate:exercise-catalog-v1:complete": "tsx scripts/validate-exercise-visual-catalog-v1.ts --complete && python scripts/validate_exercise_visual_assets.py --complete",
    "validate:exercise-catalog-v1:motion-pilot": "tsx scripts/validate-exercise-visual-catalog-v1.ts --complete --motion-pilot && python scripts/validate_exercise_visual_assets.py --complete --motion-pilot",
    "catalog:exercises:v1:audit": "tsx --env-file=.env.local scripts/exercise-catalog-v1-remote.ts audit",
    "catalog:exercises:v1:backup": "tsx --env-file=.env.local scripts/exercise-catalog-v1-remote.ts backup",
    "catalog:exercises:v1:deploy": "tsx --env-file=.env.local scripts/exercise-catalog-v1-remote.ts deploy",
    "catalog:exercises:v1:deploy:execute": "tsx --env-file=.env.local scripts/exercise-catalog-v1-remote.ts deploy --execute",
    "catalog:exercises:v1:verify": "tsx --env-file=.env.local scripts/exercise-catalog-v1-remote.ts verify",
    "test:exercise-catalog-v1:db": "tsx scripts/test-exercise-catalog-v1-db.ts",
    "archive:exercise-catalog-v1": "tsx --env-file-if-exists=.env.local scripts/archive-exercise-visual-sources.ts",
    "map:exercise-motion-previews": "tsx --env-file-if-exists=.env.local scripts/map-exercise-motion-previews.ts",
    "test": "vitest run",
    "check:supabase-migrations": "node scripts/lib/supabase-migration-workdir.mjs",
    "supabase:migrations:list": "node scripts/lib/supabase-migration-workdir.mjs --run migration list --linked",
    "supabase:migrations:dry-run": "node scripts/lib/supabase-migration-workdir.mjs --run db push --linked --dry-run",
    "supabase:migrations:push": "node scripts/lib/supabase-migration-workdir.mjs --run db push --linked",
    "test:db": "node scripts/test-trainer-foundations-db.mjs",
    "test:db:verification": "node scripts/test-trainer-verification-db.mjs",
    "test:db:relationships": "node scripts/test-trainer-relationships-db.mjs",
    "test:db:programming": "node scripts/test-trainer-programming-db.mjs",
    "test:db:template-availability": "tsx scripts/test-trainer-template-availability-db.mjs",
    "test:db:relationship-management": "node scripts/test-coach-relationship-management-db.mjs",
    "test:db:direct-assignment": "node scripts/test-trainer-direct-assignment-db.mjs",
    "test:db:insights": "node scripts/test-trainer-programming-db.mjs",
    "test:db:trainers": "node scripts/test-trainer-programming-db.mjs --authorization",
    "test:db:trainer-security": "node scripts/test-trainer-security-db.mjs",
    "test:db:marketplace": "node scripts/test-trainer-marketplace-db.mjs",
    "test:db:settings-weight": "node scripts/test-settings-weight-sync-db.mjs",
    "test:e2e:seed": "tsx --env-file=.env.local scripts/seed-e2e-account.ts",
    "test:e2e": "playwright test",
    "test:e2e:trainer-marketplace": "playwright test --config=playwright.trainer-marketplace.config.ts",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "cap:sync": "cap sync",
    "cap:android": "cap open android"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-navigation-menu": "^1.1.4",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "0.475.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^13.24.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "8.69.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.27.0"
}
