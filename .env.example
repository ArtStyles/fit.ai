NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ANTHROPIC_API_KEY=sk-ant-...
USE_AI_MOCK=true
# evidence_engine is the default. Use legacy_ai only for temporary rollback.
PLAN_GENERATION_MODE=evidence_engine
# Optional comma-separated UUID allowlist for a controlled beta.
# EVIDENCE_ENGINE_BETA_USER_IDS=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIME_ZONE=America/Havana

# Optional AI cost/model overrides
# MAX_DAILY_API_SPEND_USD=5
# ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-5
# ANTHROPIC_MODEL_FALLBACK=claude-opus-4-5

# Optional social push notifications (server-side Firebase Admin)
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Or provide the same credentials split across variables:
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-firebase-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Comma-separated list of emails that can access dev-only routes (e.g. /exercises) in production
ADMIN_EMAILS=you@example.com
