NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ANTHROPIC_API_KEY=sk-ant-...
USE_AI_MOCK=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIME_ZONE=America/Havana
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Required for destructive activation E2E. Use a dedicated hosted Supabase project only.
E2E_SUPABASE_URL=https://YOUR_E2E_PROJECT_REF.supabase.co
E2E_SUPABASE_PROJECT_REF=YOUR_E2E_PROJECT_REF
E2E_RUN_ID=local-unique-run-id
E2E_USER_EMAIL=e2e-local-unique-run-id@example.test
E2E_USER_PASSWORD=GENERATE_A_STRONG_PASSWORD_PER_RUN

# Optional AI cost/model overrides
# MAX_DAILY_API_SPEND_USD=5
# ANTHROPIC_MODEL_COACH=claude-haiku-4-5

# Optional social push notifications (server-side Firebase Admin)
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}
# Or provide the same credentials split across variables:
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-firebase-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Comma-separated list of emails that can access dev-only routes (e.g. /exercises) in production
ADMIN_EMAILS=you@example.com
