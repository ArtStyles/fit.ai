# Optional. Personal training runs without these variables.
# Only public Supabase credentials belong in a mobile bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# HTTPS origin of the deployed Vekira web backend (no trailing path).
# Deploy /api/account/delete and /delete-account before enabling account deletion.
# Confirmed public web origin: https://fit-ai-kohl.vercel.app
VITE_ACCOUNT_API_URL=
# Optional dedicated HTTPS origin for explicit web handoffs. If omitted, uses
# VITE_ACCOUNT_API_URL. Never include tokens, credentials, query or path.
VITE_WEB_APP_URL=
