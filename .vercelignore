# Only the web application is deployed to Vercel. Keep local credentials,
# signing material, device builds and audit fixtures on the development host.
# Root directory patterns intentionally omit trailing slashes: CLI archive
# mode can otherwise retain empty directory entries and traverse them again.
/.git
/.vercel
.env*
**/.env*
/.artifacts
/artifacts
/.worktrees
/.superpowers
/.codex
node_modules
/.next
/out
/coverage
/android
/mobile
/infra
/supabase
/docs
/test-results
/playwright-report
**/*.log
**/*.tsbuildinfo
