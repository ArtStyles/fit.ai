# Plantilla de credenciales de firma de release.
#
# 1. Copia este archivo a "keystore.properties" (en android/).
# 2. Genera tu keystore con keytool (ver instrucciones del proyecto).
# 3. Rellena los valores reales abajo.
#
# IMPORTANTE: keystore.properties y el .jks NUNCA se versionan (ya están en
# .gitignore). Guarda una copia de seguridad del .jks y de estas contraseñas en
# un lugar seguro: si los pierdes no podrás volver a firmar actualizaciones.

# Ruta al keystore, relativa a la carpeta android/ (o ruta absoluta).
storeFile=fitai-release.jks

# Contraseña del almacén de claves.
storePassword=CAMBIA_ESTO

# Alias de la clave dentro del keystore.
keyAlias=fitai-upload

# Contraseña de la clave (puede coincidir con storePassword).
keyPassword=CAMBIA_ESTO
