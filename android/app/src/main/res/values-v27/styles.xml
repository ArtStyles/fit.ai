<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Extend the base themes only where this platform attribute exists. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/vekira_splash_background</item>
        <item name="android:statusBarColor">@color/vekira_splash_background</item>
        <item name="android:navigationBarColor">@color/vekira_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/vekira_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vekira_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/vekira_splash_background</item>
        <item name="android:navigationBarColor">@color/vekira_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
