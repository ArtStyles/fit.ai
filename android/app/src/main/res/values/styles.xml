<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/vekira_splash_background</item>
        <item name="android:statusBarColor">@color/vekira_splash_background</item>
        <item name="android:navigationBarColor">@color/vekira_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Android 11 e inferiores usan la imagen completa solo en la ventana.
             Un background gen\u00e9rico se hereda en los selectores nativos. -->
        <item name="android:windowBackground">@drawable/splash</item>
        <!-- Android 12+ usa el splash del sistema: marca transparente, sin disco. -->
        <item name="windowSplashScreenBackground">@color/vekira_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vekira_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">250</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/vekira_splash_background</item>
        <item name="android:navigationBarColor">@color/vekira_splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
